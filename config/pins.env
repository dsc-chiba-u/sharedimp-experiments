# Commits of the two sharedimp packages used by every experiment in this
# repository, and (below) the container images built from exactly these
# commits. workflow/01_environment.smk fails if a process does not run inside
# the pinned image or if the image is not the pinned commit.
# Change a pin only together with a re-run of all experiments.
SHAREDIMP_R_REPO=https://github.com/dsc-chiba-u/sharedimp-r.git
SHAREDIMP_R_COMMIT=cf2e1cc6716cb76f4acd6d6f49a42a7340c48a10
SHAREDIMP_PY_REPO=https://github.com/dsc-chiba-u/sharedimp-py.git
SHAREDIMP_PY_COMMIT=bacc5d8cabf212a6b6d03e0dd9484951f4fd60e1
# Public container images of the two packages (every rule runs inside one of them)
SHAREDIMP_R_IMAGE=ghcr.io/dsc-chiba-u/sharedimp-r
SHAREDIMP_PY_IMAGE=ghcr.io/dsc-chiba-u/sharedimp-py
# Digests of the image tags named after the pinned commits (cf2e1cc, bacc5d8).
# The workflows run the images by digest, never by a mutable tag;
# python/sharedimp_exp/docker_info.py checks that each digest is the commit tag
# and that its org.opencontainers.image.revision label is the pinned commit.
SHAREDIMP_R_IMAGE_DIGEST=sha256:869dbec7077cfbfcea4f0da25d8ce51e1c4e6d4297106d11a965cada1d8a0805
SHAREDIMP_PY_IMAGE_DIGEST=sha256:c88b48a58848d3583d14d60a9b6dabe73e26733c0c24e986153d12981a0edebe
# Images built by .github/workflows/docker.yml from docker/ at the commit of this
# repository given by PHASE2_IMAGES_COMMIT (tag = its first 7 characters).
# EXP_R: the pinned sharedimp-r image plus dependencies of the official UMFI R
# package and plotting packages (sharedimp is not reinstalled).
# UMFI_PY: dependencies of the official Python UMFI code (Python 3.9); neither
# image contains official UMFI code.
PHASE2_IMAGES_COMMIT=408e962c5c19a34b4d60912555705697cc650399
SHAREDIMP_EXP_R_IMAGE=ghcr.io/dsc-chiba-u/sharedimp-experiments-r
SHAREDIMP_EXP_R_IMAGE_DIGEST=sha256:803daedb5ce5b39246eefb63c823e0f0a7b5c8bb869f6d4283884d7142d84c1f
UMFI_PY_IMAGE=ghcr.io/dsc-chiba-u/umfi-official-py
UMFI_PY_IMAGE_DIGEST=sha256:2e44cc61c15ecd87b679b20025e6c53f8bd7ad3c5fb1efadc8855537ca47bef6
# Official UMFI sources (fetched at run time into external/, never committed)
UMFI_R_REPO=https://github.com/HydroML/UMFI.git
UMFI_R_COMMIT=54b964740ffb006d3ade759d84dc6e9af2f45998
UMFI_PY_REPO=https://github.com/guanton/umfi_python.git
UMFI_PY_COMMIT=4db1c23f2355d69fc1471ae8df89c196d7a9a347
UMFI_ORIG_REPO=https://github.com/joej1997/UMFI.git
UMFI_ORIG_COMMIT=16ef563fda5aae1fdb6544001a0f04450799c134
# Image that builds paper/manuscript.Rmd (workflow/07_manuscript.smk): the
# EXP_R image plus pandoc, TeX Live and rticles; built by
# .github/workflows/docker.yml from docker/manuscript at MANUSCRIPT_IMAGE_COMMIT.
# No experiment runs in it.
MANUSCRIPT_IMAGE_COMMIT=2aecf91851f57799ef09da84f21f9e6daf84cbc6
MANUSCRIPT_IMAGE=ghcr.io/dsc-chiba-u/sharedimp-manuscript
MANUSCRIPT_IMAGE_DIGEST=sha256:52a4653ce82377b1da3da44be5ccb3c10b3f40beee0907adddf1c735e5d7d9e6
